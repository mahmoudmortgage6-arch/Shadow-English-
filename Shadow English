const isObj=x=>!!x&&typeof x==="object"&&!Array.isArray(x);

const defaults=()=>({v:STATE_VERSION,course:"en-a2",lang:"ar",theme:"",
  speed:1,gap:1,accent:"US",voice:"",arv:false,
  rmode:"ref",reps:2,cap:5,shadowOn:true,dreps:3,wreps:7,
  syn:false,hide:false,auto:true,goal:30,cmLen:60,
  drv:{mode:"repeat",reps:7,len:17},
  last:"",sent:{},vocab:{},rv:{},use:{},book:{},dlg:{},gram:{},vq:{},read:{},pron:{},dv:{},days:{},
  cm:{l:0,p:0,i:0},sess:null,reports:[],tutor:TU_DEFAULT(),dev:"",setAt:0,updatedAt:0});

/* Fill a parsed state with defaults and repair wrong types, so a damaged field cannot break the app. */
function fillState(r){const d=defaults(),o=Object.assign({},d,isObj(r)?r:{});
  for(const k of Object.keys(d)){const want=d[k];
    if(isObj(want)&&!isObj(o[k]))o[k]=want;
    else if(Array.isArray(want)&&!Array.isArray(o[k]))o[k]=want;
    else if(typeof want==="number"&&typeof o[k]!=="number")o[k]=want;
    else if(typeof want==="string"&&typeof o[k]!=="string")o[k]=want;
    else if(typeof want==="boolean"&&typeof o[k]!=="boolean")o[k]=want}
  o.drv=Object.assign({},d.drv,o.drv);o.cm=Object.assign({},d.cm,o.cm);o.tutor=fillTutor(o.tutor);
  if(!PLANS.includes(o.goal))o.goal=o.goal>=90?120:o.goal>=45?60:o.goal>=20?30:15;
  if(!["ref","fixed","adaptive"].includes(o.rmode))o.rmode="ref";
  o.v=STATE_VERSION;return o}

/* v1 -> v2. Every v1 key keeps its name and its item keys ("l1-3", "d02-y4_1"), so no progress is renamed or dropped.
   v1 learners chose their own repetition counts, so they stay on fixed repetition; new learners start on the reference sequence. */
function migrateState(r){if(!isObj(r))return defaults();
  if(r.v===STATE_VERSION)return fillState(r);
  const o=JSON.parse(JSON.stringify(r));
  o.rmode="fixed";o.migratedFrom=r.v||1;delete o.g120;
  if(isObj(o.days))for(const k of Object.keys(o.days)){const d=o.days[k];if(isObj(d)&&d.tot==null){d.tot=d.sec||0}}
  return fillState(o)}

/* ---------- answer checking ---------- */
/* Only harmless differences are removed: case, spacing, punctuation, apostrophe style, and contractions with ONE possible meaning.
   'd (had / would) and 's (is / has / possessive) are left exactly as typed: each exercise lists its own accepted forms. */
const normAns=s=>String(s).toLowerCase().replace(/[’‘`´]/g,"'")
  .replace(/\bcan't\b/g,"can not").replace(/\bcannot\b/g,"can not").replace(/\bwon't\b/g,"will not")
  .replace(/n't\b/g," not").replace(/'ve\b/g," have").replace(/'ll\b/g," will").replace(/\bi'm\b/g,"i am").replace(/'re\b/g," are")
  .replace(/[^a-z0-9' ]/g," ").replace(/\s+/g," ").trim();
const isRight=(val,acc)=>{const v=normAns(val);return !!v&&acc.some(a=>normAns(a)===v)};
const hintFor=acc=>{const w=String(acc[0]).trim().split(/\s+/);return {first:w[0].replace(/[.,!?]$/,""),words:w.length}};

/* ---------- review scheduling (one rule for every kind of item) ---------- */
const IV=[0,1,2,4,7,15,30];
/* grade: 0 = wrong / "again", 1 = right / "good", 2 = "easy". Box 0-6; the interval in days is IV[box]. */
function schedule(rec,grade,today){const r=Object.assign({box:0,n:0,bad:0},rec);r.n=(r.n||0)+1;
  if(grade===0){r.bad=(r.bad||0)+1;r.box=1;r.due=today}
  else{r.box=Math.min(IV.length-1,(r.box||0)+(grade===2?2:1));r.due=addDays(today,IV[r.box])}
  return r}
const isDue=(rec,today)=>!!rec&&!!rec.due&&rec.due<=today&&(rec.box||0)<IV.length-1;
/* how many review items fit the learner's day: about a fifth of the plan, at roughly 20 seconds an item */
const reviewCap=goal=>Math.max(6,Math.round(goal*60*0.2/20));

/* ---------- repetition rules ---------- */
/* Returns the sequence for one sentence. pattern "block" = models first, then speaking turns; "alt" = model, turn, model, turn. */
function repsFor(S,rec,due){
  if(S.rmode==="fixed")return {model:S.reps,turns:S.reps,pattern:"alt",recall:false,why:"fixed"};
  if(S.rmode==="ref")return {model:2,turns:2,pattern:"block",recall:false,why:"ref"};
  const cap=Math.max(2,S.cap||5);
  if(due)return {model:1,turns:2,pattern:"alt",recall:true,why:"due"};
  if(!rec||!rec.n)return {model:Math.min(3,cap),turns:Math.min(3,cap),pattern:"alt",recall:false,why:"new"};
  if(rec.rate==="hard")return {model:cap,turns:cap,pattern:"alt",recall:false,why:"hard"};
  if(rec.rate==="easy")return {model:1,turns:1,pattern:"alt",recall:false,why:"easy"};
  return {model:2,turns:2,pattern:"alt",recall:false,why:"seen"}}
const driveReps=(S,rec)=>S.drv.reps==="adaptive"?repsFor(Object.assign({},S,{rmode:"adaptive"}),rec,false).model:(+S.drv.reps||7);

/* ---------- lesson status: one definition used by every screen ---------- */
function lessonStat(S,L,today){let s=0,v=0,due=0;const id=L.id;
  for(let i=0;i<17;i++){if(S.sent[id+"-"+i]&&S.sent[id+"-"+i].n)s++;if(S.vocab[id+"-"+i])v++}
  const d=S.dlg[id]&&S.dlg[id].done?1:0,g=S.gram[id]?1:0,r=S.read[id]?1:0,p=S.pron[id]?1:0;
  const ud=L.u?useKeys(L).filter(k=>S.use[k]).length:0,un=L.u?useKeys(L).length:0,u=un&&ud===un?1:0;
  if(today){for(const k in S.vocab)if(k.startsWith(id+"-")&&isDue(S.vocab[k],today))due++;
    for(const k in S.rv)if(k.split(":")[1]&&k.split(":")[1].startsWith(id+"-")&&isDue(S.rv[k],today))due++}
  const core=s===17&&v===17&&!!d&&!!g,full=core&&!!r&&!!p&&!!u,started=s+v+d+g+r+p+ud>0;
  const status=!started?"new":due&&core?"review":full?"full":core?"core":"progress";
  return {s,v,d,g,r,p,u,ud,un,due,core,full,started,status,pct:Math.round((s+v+17*(d+g+r+p)+17*(un?ud/un:0))/119*100)}}
const useKeys=L=>{const u=L.u,o=[];if(!u)return o;u.p.forEach((x,i)=>o.push(L.id+"-up"+i));u.t.forEach((x,i)=>o.push(L.id+"-ut"+i));u.q.forEach((x,i)=>o.push(L.id+"-uq"+i));o.push(L.id+"-urp",L.id+"-utalk");return o};
/* The lesson to continue: the first one whose core practice is not complete. */
const currentLesson=(S,LS)=>LS.find(L=>!lessonStat(S,L).core)||LS[LS.length-1];

/* ---------- session planner ---------- */
const words=x=>String(x).trim().split(/\s+/).length;
const sayMs=(x,speed)=>Math.max(900,words(x)*430/(speed||1)+350);
/* Estimated seconds to practise one item with the current settings. Planning targets only. */
function estSentence(S,L,i){const x=L.s[i][0].replace(/[*‿]/g,""),r=repsFor(S,S.sent[L.id+"-"+i],false),a=sayMs(x,S.speed)/1000;
  return a*r.model+a*1.15*S.gap*r.turns+(S.shadowOn?a:0)+3}
function estWord(S,L,i){const w=sayMs(L.v[i][0],S.speed)/1000;let e=S.wreps*(w+w*1.1*S.gap);
  L.x[i][0].forEach(x=>{const a=sayMs(x[1],S.speed)/1000;e+=a+a*1.1*S.gap});return e+16}
function estTurn(S,L,i){const a=sayMs(L.d[i][1],S.speed)/1000;return S.dreps*(a+a*1.1*S.gap)}
const QUOTA={15:{rv:3,s:5,v:5,d:0,extra:["use1"]},30:{rv:4,s:9,v:9,d:6,extra:["gram2"]},
  60:{rv:8,s:17,v:17,d:17,extra:["read|gram","use3"]},120:{rv:12,s:17,v:17,d:17,extra:["read","pron","gram","use","final"]}};
/* The quotas are targets. If the estimate runs more than 10% over the plan, the word and sentence counts are trimmed (never below 3). */
function buildSession(S,L,min,dueCount,today){const base=QUOTA[min]||QUOTA[30];let q=Object.assign({},base),se=planOnce(S,L,min,dueCount,today,q),guard=0;
  while(se.est>min*1.1&&guard++<30&&(q.v>3||q.s>3)){if(q.v>3&&(q.v>=q.s||q.s<=3))q.v--;else q.s--;se=planOnce(S,L,min,dueCount,today,q)}
  return se}
function planOnce(S,L,min,dueCount,today,q){const steps=[],id=L.id;let total=0;
  const push=(type,from,n,sec,extra)=>{const st=Object.assign({k:type+":"+from+":"+n,type,from,n,min:Math.max(1,Math.round(sec/60)),done:false},extra||{});steps.push(st);total+=sec};
  const nextFree=(has)=>{for(let i=0;i<17;i++)if(!has(i))return i;return 17};
  if(dueCount>0){const n=Math.min(dueCount,reviewCap(min),q.rv*3);push("review",0,n,n*20)}
  const s0=nextFree(i=>S.sent[id+"-"+i]&&S.sent[id+"-"+i].n);
  if(s0<17&&q.s){const n=Math.min(q.s,17-s0);let sec=0;for(let i=s0;i<s0+n;i++)sec+=estSentence(S,L,i);push("shadow",s0,n,sec)}
  const v0=nextFree(i=>S.vocab[id+"-"+i]);
  if(v0<17&&q.v){const n=Math.min(q.v,17-v0);let sec=0;for(let i=v0;i<v0+n;i++)sec+=estWord(S,L,i);push("vocab",v0,n,sec)}
  const dDone=S.dlg[id]&&S.dlg[id].done,d0=dDone?17:Math.min(16,(S.dlg[id]&&S.dlg[id].pos)||0);
  if(!dDone&&q.d){const n=Math.min(q.d,17-d0);let sec=0;for(let i=d0;i<d0+n;i++)sec+=estTurn(S,L,i);push("dlg",d0,n,sec)}
  const st=lessonStat(S,L),uk=useKeys(L),uLeft=uk.filter(k=>!S.use[k]).length;
  const extra=name=>{
    if(name==="use1"&&uLeft)push("use",0,1,120);
    else if(name==="use3"&&uLeft)push("use",0,Math.min(3,uLeft),330);
    else if(name==="use"&&uLeft)push("use",0,uLeft,uLeft*100);
    else if(name==="gram2")push("gram",0,2,180,{quick:true});
    else if(name==="gram"&&!st.g)push("gram",0,18,900);
    else if(name==="final"&&!st.g)push("final",0,10,300);
    else if(name==="read"&&!st.r)push("read",0,1,720);
    else if(name==="pron"&&!st.p)push("pron",0,1,540);
    else if(name==="read|gram"){if(!st.r)push("read",0,1,720);else if(!st.g)push("gram",0,18,900)}};
  q.extra.forEach(extra);
  /* a lesson that is nearly finished leaves room: fill it with whatever is still open, never past the plan */
  const cost={read:720,pron:540,use3:330,gram:900};
  for(const name of ["read","pron","use3","gram"]){if(total>=min*60*0.7)break;if(total+cost[name]>min*60*1.05)continue;
    const have=t=>steps.some(x=>x.type===t);
