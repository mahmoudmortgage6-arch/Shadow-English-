<body>
<style>
/* Layout: one 760px practice column, sticky brand bar on top, four-tab bar fixed at the bottom; every lesson is measured on a 17-tick ruler. */
:root{
  --bg:#edf2ef; --surface:#ffffff; --sunk:#e1e9e4; --ink:#0c1f18; --muted:#4f695e; --line:#ccd9d2;
  --brand:#0d4f3c; --brand-ink:#ffffff; --hero:#0d4f3c; --hero-ink:#f1faf5; --hero-muted:#a9cdbf;
  --gold:#a86a0c; --ok:#167a4a; --bad:#b3372b; --shadow:0 1px 2px rgba(12,31,24,.06),0 8px 24px rgba(12,31,24,.06);
  --display:"Readex Pro","IBM Plex Sans Arabic",system-ui,sans-serif;
  --body:"IBM Plex Sans","IBM Plex Sans Arabic",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#07130f; --surface:#0f211b; --sunk:#0a1914; --ink:#e9f3ee; --muted:#93aba0; --line:#213a31;
  --brand:#37c693; --brand-ink:#04140e; --hero:#123d30; --hero-ink:#f1faf5; --hero-muted:#9cc4b4;
  --gold:#f0b94a; --ok:#4cd08f; --bad:#ff8171; --shadow:0 1px 2px rgba(0,0,0,.4); color-scheme:dark } }
:root[data-theme="dark"]{
  --bg:#07130f; --surface:#0f211b; --sunk:#0a1914; --ink:#e9f3ee; --muted:#93aba0; --line:#213a31;
  --brand:#37c693; --brand-ink:#04140e; --hero:#123d30; --hero-ink:#f1faf5; --hero-muted:#9cc4b4;
  --gold:#f0b94a; --ok:#4cd08f; --bad:#ff8171; --shadow:0 1px 2px rgba(0,0,0,.4); color-scheme:dark }
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.6;padding-bottom:calc(84px + env(safe-area-inset-bottom,0px))}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.wrap{max-width:760px;margin:0 auto;padding-inline:16px;padding-block:16px;display:flex;flex-direction:column;gap:16px}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.top .in{max-width:760px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:10px}
.brand{font-family:var(--display);font-weight:700;font-size:18px;letter-spacing:.01em;flex:1;min-width:0}
.brand small{display:block;font-family:var(--body);font-weight:500;font-size:12px;color:var(--muted)}
.ib{border:1px solid var(--line);background:var(--surface);border-radius:999px;min-width:44px;height:40px;padding:0 12px;font-weight:600;font-size:14px}
h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance;line-height:1.25}
h1{font-size:26px} h2{font-size:19px} h3{font-size:16px}
p{margin:0}
.muted{color:var(--muted)} .sm{font-size:13.5px}
.en{direction:ltr;unicode-bidi:isolate;text-align:left} .ar{direction:rtl;unicode-bidi:isolate;text-align:right}
.center{text-align:center}
.label{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
:lang(ar) .label,[dir=rtl] .label{letter-spacing:0;font-size:13px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px;min-width:0}
.hero{background:var(--hero);color:var(--hero-ink);border-radius:18px;padding:22px 20px;display:flex;flex-direction:column;gap:14px;box-shadow:var(--shadow)}
.hero .muted,.hero .label{color:var(--hero-muted)}
.hero h1{font-size:30px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.row>.grow{flex:1;min-width:0}
.col{display:flex;flex-direction:column;gap:10px;min-width:0}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 16px;font-weight:600;min-height:44px}
.btn.primary{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.btn.ghost{background:transparent}
.hero .btn{color:var(--ink)}
.hero .btn.primary{background:var(--hero-ink);border-color:var(--hero-ink);color:var(--hero)}
.btn.big{font-size:18px;padding:14px 26px;border-radius:14px}
.btn:disabled{opacity:.45;cursor:default}
.btn.ok{border-color:var(--ok);color:var(--ok)} .btn.bad{border-color:var(--bad);color:var(--bad)}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 14px;font-size:14px;font-weight:600;min-height:38px}
.chip[aria-pressed=true]{background:var(--brand);border-color:var(--brand);color:var(--brand-ink)}
.seg{display:flex;background:var(--sunk);border-radius:12px;padding:4px;gap:4px;overflow-x:auto}
.seg button{flex:1;border:0;background:transparent;border-radius:9px;padding:9px 10px;font-weight:600;font-size:14px;white-space:nowrap;min-height:44px;color:var(--muted)}
.seg button[aria-selected=true]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.badge{display:inline-block;border-radius:6px;padding:2px 8px;font-size:12px;font-weight:700;background:var(--sunk);color:var(--ink);font-variant-numeric:tabular-nums}
.badge.lv{background:var(--brand);color:var(--brand-ink)}
.ticks{display:grid;grid-template-columns:repeat(17,1fr);gap:3px;direction:ltr}
.ticks button{height:22px;border:0;border-radius:3px;background:var(--sunk);padding:0}
.ticks button.done{background:var(--brand)}
.ticks button.hard{background:var(--gold)}
.ticks button.cur{outline:2px solid var(--ink);outline-offset:1px}
.ticks.mini button{height:6px;pointer-events:none}
.bar{height:8px;background:var(--sunk);border-radius:99px;overflow:hidden;direction:ltr}
.bar i{display:block;height:100%;background:var(--brand);border-radius:99px}
.hero .bar{background:rgba(255,255,255,.18)} .hero .bar i{background:var(--hero-ink)}
.sent{font-family:var(--display);font-weight:500;font-size:clamp(22px,5.4vw,30px);line-height:1.45;text-align:center;direction:ltr}
.sent b{font-weight:700;color:var(--brand)}
.sent .lk{font-style:normal;color:var(--gold);font-weight:700;margin:0 -1px}
.sent.blur{filter:blur(9px);user-select:none}
.tip{background:var(--sunk);border-radius:10px;padding:10px 12px;font-size:14.5px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.steps span{text-align:center;font-size:13px;font-weight:600;padding:7px 4px;border-radius:8px;background:var(--sunk);color:var(--muted)}
.steps span.on{background:var(--gold);color:var(--surface)}
.ipa{font-family:var(--body);color:var(--muted);direction:ltr;unicode-bidi:isolate}
.word{font-family:var(--display);font-size:34px;font-weight:700;direction:ltr;text-align:center}
.list{display:flex;flex-direction:column}
.list>*{padding:10px 0;border-top:1px solid var(--line)} .list>*:first-child{border-top:0}
.tap{display:flex;gap:10px;align-items:flex-start;background:none;border:0;width:100%;text-align:inherit;padding:0}
.tap>.grow{flex:1;min-width:0}
.list>.tap{padding:10px 0}
.tap .pl{flex:none;width:30px;height:30px;font-weight:700;font-variant-numeric:tabular-nums;border-radius:50%;background:var(--sunk);display:grid;place-items:center;font-size:12px;color:var(--brand)}
.bub{max-width:88%;border-radius:14px;padding:10px 14px;background:var(--sunk);border:1px solid transparent;display:flex;flex-direction:column;gap:2px}
.bub.b{align-self:flex-end;background:var(--surface);border-color:var(--line)}
.bub.cur{border-color:var(--gold);box-shadow:0 0 0 2px var(--gold)}
.bub .who{font-size:12px;font-weight:700;color:var(--brand);direction:ltr}
.dlg{display:flex;flex-direction:column;gap:8px;direction:ltr}
.tbl{overflow-x:auto} table{border-collapse:collapse;width:100%;font-size:14.5px}
th,td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top} th{background:var(--sunk);font-weight:600}
.formula{font-weight:600;color:var(--brand);direction:ltr;unicode-bidi:isolate}
.wrong{color:var(--bad);text-decoration:line-through} .right{color:var(--ok);font-weight:600}
.q{display:flex;flex-direction:column;gap:8px}
.q input[type=text]{width:100%;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px;direction:ltr;min-height:44px}
.opts{display:grid;gap:8px}
.opt{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 12px;text-align:start;min-height:44px}
.opt.good{border-color:var(--ok);box-shadow:inset 0 0 0 1px var(--ok)} .opt.poor{border-color:var(--bad);box-shadow:inset 0 0 0 1px var(--bad)}
.fb{font-size:14.5px;font-weight:600} .fb.good{color:var(--ok)} .fb.poor{color:var(--bad)}
.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:620px){.tiles{grid-template-columns:repeat(4,1fr)}}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px}
.tile b{display:block;font-family:var(--display);font-size:26px;font-variant-numeric:tabular-nums;line-height:1.2}
.chart{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;align-items:end;height:150px;direction:ltr}
.chart div{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;height:100%;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.chart i{display:block;width:100%;max-width:38px;background:var(--brand);border-radius:6px 6px 2px 2px;min-height:2px}
.chart div.now i{background:var(--gold)}
.goBtn{width:168px;height:168px;border-radius:50%;border:0;background:var(--hero-ink);color:var(--hero);font-family:var(--display);font-weight:700;font-size:22px;align-self:center}
.seg.six button{padding:9px 6px;font-size:13.5px}
.btn.drive{width:100%;min-height:54px;font-size:16px;font-weight:700;background:var(--gold);border-color:var(--gold);color:var(--surface);display:flex;align-items:center;justify-content:center;gap:10px;border-radius:14px}
.btn.drive svg{flex:none}
.para{font-size:18.5px;line-height:1.95;direction:ltr;text-align:left}
.para span{cursor:pointer;border-radius:6px;padding:3px 2px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.para span.cur{background:var(--gold);color:var(--surface)}
.para.blur{filter:blur(8px);user-select:none}
.steplist{margin:0;padding-inline-start:22px;display:flex;flex-direction:column;gap:6px}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;direction:ltr}
.pair button{min-height:48px;font-family:var(--display);font-size:18px}
.dtxt{font-family:var(--display);font-weight:700;font-size:clamp(24px,6.4vw,34px);line-height:1.4;text-align:center;direction:ltr;unicode-bidi:isolate}
.dnum{font-family:var(--display);font-size:44px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;line-height:1.1;direction:ltr}
.stopBar{width:100%;min-height:96px;border-radius:18px;border:0;background:var(--hero-ink);color:var(--hero);font-family:var(--display);font-weight:700;font-size:26px}
.note{border:1px dashed var(--line);border-radius:10px;padding:10px 12px;font-size:14px;color:var(--muted)}
.star{border:0;background:none;font-size:24px;line-height:1;color:var(--muted);min-width:44px;min-height:44px}
.star.on{color:var(--gold)}
nav{position:fixed;inset-inline:0;bottom:0;z-index:6;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
nav .in{max-width:760px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
nav button{border:0;background:none;padding:10px 4px 12px;font-weight:600;font-size:13.5px;color:var(--muted);border-top:3px solid transparent;min-height:56px}
nav button[aria-current=page]{color:var(--brand);border-top-color:var(--brand)}
details summary{cursor:pointer;font-weight:600}
details.card summary .badge{float:inline-end}
select{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 10px;min-height:44px;max-width:100%}
@media (prefers-reduced-motion:no-preference){.bar i,.chart i{transition:all .3s}}
/* version 2 additions */
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;inset-inline-start:8px;top:-60px;z-index:20;background:var(--brand);color:var(--brand-ink);padding:10px 14px;border-radius:10px;font-weight:600}
.skip:focus{top:8px}
.chip{min-height:44px}
.badge.st-new{background:var(--sunk);color:var(--muted)} .badge.st-progress{background:var(--sunk);color:var(--ink)}
.badge.st-core{background:var(--brand);color:var(--brand-ink)} .badge.st-full{background:var(--ok);color:var(--surface)} .badge.st-review{background:var(--gold);color:var(--surface)}
.badge{white-space:nowrap}
nav button{position:relative}
.dot{display:inline-block;min-width:18px;margin-inline-start:6px;padding:0 5px;border-radius:99px;background:var(--gold);color:var(--surface);font-size:11px;font-weight:700;line-height:18px;font-variant-numeric:tabular-nums}
.tick{flex:none;width:44px;height:44px;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-weight:700;font-size:18px;color:var(--brand-ink)}
.tick.on{background:var(--brand);border-color:var(--brand)}
.chk{display:flex;gap:10px;align-items:center;background:none;border:0;padding:6px 0;min-height:44px;text-align:start;width:100%}
.chk .box{flex:none;width:26px;height:26px;border-radius:7px;border:2px solid var(--line);display:grid;place-items:center;font-weight:700;color:var(--brand-ink)}
.chk[aria-pressed=true] .box{background:var(--brand);border-color:var(--brand)}
.bubrow{display:flex;align-items:center;gap:2px;max-width:100%} .bubrow.b{flex-direction:row-reverse}
.bubrow .bub{max-width:calc(100% - 48px)}
.rec{padding-top:2px}
#player{position:fixed;inset-inline:0;bottom:calc(60px + env(safe-area-inset-bottom,0px));z-index:6;background:var(--hero);color:var(--hero-ink)}
#player .in{max-width:760px;margin:0 auto;padding:8px 16px;display:flex;align-items:center;gap:10px;font-weight:600}
#player .btn{min-height:44px}
#player .btn.primary{background:var(--hero-ink);border-color:var(--hero-ink);color:var(--hero)}
body.playing{padding-bottom:calc(150px + env(safe-area-inset-bottom,0px))}
input[type=search],textarea{width:100%;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 12px;min-height:44px;font:inherit}
textarea{direction:ltr;font-size:12.5px;font-family:ui-monospace,Menlo,Consolas,monospace}
input[type=file]{max-width:100%}
.steplist.sm{font-size:13.5px}
h1:focus,h2:focus{outline:none}
.btn.primary.ok{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.pair .btn.ok{box-shadow:inset 0 0 0 1px var(--ok)} .pair .btn.bad{box-shadow:inset 0 0 0 1px var(--bad)}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
/* AI tutor */
.btn.tutorb{display:inline-flex;align-items:center;gap:8px;border-color:var(--gold);color:var(--gold);font-weight:700}
.btn.tutorb svg{flex:none}
.btn.tutorb.big{width:100%;justify-content:center;min-height:52px;font-size:17px;background:var(--gold);color:var(--surface);border-radius:14px}
.btn.tutorb.ghostb{align-self:flex-start}
.star.tut{color:var(--gold);display:grid;place-items:center}
.bubrow .bub{max-width:calc(100% - 92px)}
.tuhead .tuav{flex:none;width:54px;height:54px;border-radius:50%;background:var(--hero-ink);color:var(--hero);display:grid;place-items:center}
.tulog{gap:14px}
.tum{display:flex;flex-direction:column;gap:8px;border-radius:14px;padding:12px 14px;max-width:100%;min-width:0}
.tum.t{background:var(--sunk)} .tum.s{background:var(--brand);color:var(--brand-ink);align-self:flex-end;max-width:88%}
.tum.s .muted{color:inherit;opacity:.8}
.tufb{border-inline-start:4px solid var(--gold);padding-inline-start:10px;display:flex;flex-direction:column;gap:6px}
.tufb.good{border-color:var(--ok)} .tufb.poor{border-color:var(--bad)}
.tuq{background:var(--surface);border:1px solid var(--gold);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:6px}
.tusay{background:var(--surface);border-radius:12px;padding:8px 10px!important;font-size:17px;font-weight:600}
#in-tutor{font-family:inherit;font-size:16px;direction:ltr;min-height:64px;resize:vertical}
.tucmds .chip{font-weight:600}
.chip:disabled{opacity:.45;cursor:default}
.btn.tusm{min-height:44px;padding:6px 12px;font-size:14px}
.badge[dir=ltr]{direction:ltr}
.badge{unicode-bidi:plaintext}
</style>
