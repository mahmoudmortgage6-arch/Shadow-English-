tuSet:d=>{const f=d.f,v=d.v,tu=S.tutor;tu[f]=["on","consent","speak","profileOn"].includes(f)?v==="1":v;if(f==="on"&&tu.on)V.aiOff="";saveSet();render();
  if(V.tab==="tutor"&&V.tu&&f==="on"&&tutorLive()&&!V.tu.started)tutorSend("start")},
tuClear:()=>{S.tutor.profile={needs:{},asks:{},sessions:[],acts:0};saveSet();render()},
tuCmd:d=>{const se=V.tu,c=TUTOR_CMDS.find(x=>x[0]===d.c);if(!se||!c)return;const tu=S.tutor;
  if(c[0]==="back")return tutorClose();
  if(c[0]==="slow"){const r=se.last,tx=r&&(r.say||(r.feedback&&r.feedback.corrected)||(r.examples[0]&&r.examples[0].en)||(r.question&&r.question.en));if(tx)once(tx,{rate:0.7});return}
  if(c[0]==="repeat"){const r=se.last;if(!r)return;const el=document.querySelectorAll(".tum.t");if(el.length)el[el.length-1].scrollIntoView({block:"start"});const en=r.explanation.en||r.examples.map(e=>e.en).join(". ");
    if(r.explanation.ar&&arVoice())once(r.explanation.ar,{lang:"ar",rate:1});else if(en)once(en);else announce(t("tuRepShown"));return}
  if(c[0]==="ar"||c[0]==="en"){tu.explain=c[0];saveSet();if(tutorLive()&&se.started&&!se.busy&&!se.paused)tutorSend("command",null,"From now on explain in "+(c[0]==="ar"?"simple Egyptian Arabic":"simple English")+". Give your last explanation again in that language, shorter, then repeat the question.");else render();return}
  if(se.busy||se.paused)return;if(tu.profileOn&&["simpler","lost","examples"].includes(c[0])){noteAsk(tu.profile,c[0],se.lid,se.section)}
