quizStart:()=>{const L=cur(),ty=V.qtype||"en2ar";let idx=[...Array(17).keys()];if(ty==="gap")idx=idx.filter(i=>gapOf(L.v[i]));
  if(ty==="gap"&&idx.length<4){V.qtype="en2ar";return A.quizStart()}
  V.q={lid:V.lid,type:ty,items:shuffle(idx).slice(0,ty==="own"?5:Math.min(10,idx.length)),i:0,score:0,pick:null};quizOpts();render()},
quizPick:d=>{const q=V.q,L=cur(),w=L.v[q.items[q.i]],k=L.id+"-"+q.items[q.i];q.pick=+d.i;touchEx();day().it++;
  if(q.type!=="own"){const ok=q.opts[q.pick]===(q.type==="en2ar"?w[3]:w[0]);if(ok)q.score++;else{S.vocab[k]=stamp(schedule(Object.assign({seen:1},S.vocab[k]),0,dayStr()))}}save();render()},
quizNext:()=>{const q=V.q;q.i++;q.pick=null;if(q.i>=q.items.length){if(q.type!=="own"){const r=S.vq[V.lid]||(S.vq[V.lid]={best:0}),sc=Math.round(q.score/q.items.length*10);r.last=sc;r.best=Math.max(r.best,sc);stamp(r);save()}}else quizOpts();render()},
dtr:()=>{V.dtr=!V.dtr;render()}, dlg:()=>{V.range=null;V.step=-1;runDlg()},
und:()=>runUnderstand(), undTr:()=>{V.und.tr=!V.und.tr;render()},
pick:d=>{const ok=+d.i===+d.c;V.ans[d.k]=+d.i;day().it++;touchEx();
  const m=d.k.match(/^(.+)-rq-\d+$/);if(m&&byId(m[1])&&byId(m[1]).r.q.every((x,n)=>V.ans[m[1]+"-rq-"+n]!=null)){S.read[m[1]]=stamp({done:1});stepDone()}
  if(/-mcq-\d+$/.test(d.k)&&!ok)rvAdd("g:"+d.k,1);
  announce(ok?t("correct"):t("incorrect"));save();render()},
checkT:d=>{grab();const val=V.draft[d.k]||"";if(!val.trim())return;const acc=JSON.parse(d.acc),ok=isRight(val,acc);touchEx();
  if(!ok&&!(V.tries[d.k]>=1)){V.tries[d.k]=1;announce(t("tryAgain"));render();const el=document.getElementById("in-"+d.k);if(el)el.focus();return}
  V.ans[d.k]={val,ok};day().it++;if(!ok)rvAdd("g:"+d.k,1);announce(ok?t("correct"):t("incorrect")+" "+acc[0]);save();render()},
report:d=>{const a=V.ans[d.k];if(!a)return;a.rep=true;S.reports.push({id:d.k+":"+Date.now(),key:d.k,val:a.val,at:new Date().toISOString(),content:CONTENT_META.version});delete S.rv["g:"+d.k];save();render()},
finStart:()=>{stop();V.fin={lid:V.lid,items:shuffle(pool(cur())).slice(0,10),i:0,score:0,a:null};V.draft.fin="";render();window.scrollTo(0,0)},
finPick:d=>{const f=V.fin,x=f.items[f.i];f.a={pick:+d.i,ok:+d.i===x.c};touchEx();if(f.a.ok)f.score++;else rvAdd("g:"+x.key,1);render()},
finCheck:()=>{grab();const f=V.fin,x=f.items[f.i],val=V.draft.fin||"";if(!val.trim())return;f.a={val,ok:isRight(val,x.a)};touchEx();if(f.a.ok)f.score++;else rvAdd("g:"+x.key,1);render()},
finReport:()=>{const f=V.fin,x=f.items[f.i];if(!f.a||f.a.rep)return;f.a.rep=true;S.reports.push({id:x.key+":"+Date.now(),key:x.key,val:f.a.val,at:new Date().toISOString(),content:CONTENT_META.version});delete S.rv["g:"+x.key];save();render()},
finNext:()=>{const f=V.fin;f.i++;f.a=null;V.draft.fin="";const inp=document.getElementById("in-fin");if(inp)inp.value="";if(f.i>=f.items.length){const pc=Math.round(f.score/f.items.length*100),r=S.gram[f.lid]||(S.gram[f.lid]={best:0});r.last=pc;r.best=Math.max(r.best,pc);stamp(r);day().it+=10;stepDone();save()}render()},
finClose:()=>{V.fin=null;render()},
commute:()=>runCommute(), cmRestart:()=>{stop();S.cm={l:Math.max(0,LESSONS.indexOf(todayL())),p:0,i:0};V.cmSec=0;save();render()},cmLen:d=>setOpt("cmLen",+d.v),
drive:d=>runDrive(d.k,d.l?byId(d.l):cur()), drvReset:d=>{S.dv[d.k+":"+V.lid]=0;save();render()},
drvSet:d=>{S.drv[d.f]=d.f==="mode"?d.v:d.v==="adaptive"?"adaptive":+d.v;saveSet();render()},
read:d=>runRead(+d.m), rtr:()=>{V.rtr=!V.rtr;render()}, rhide:()=>{V.rhide=!V.rhide;render()}, pron:()=>runPron(),
pqStart:()=>{const L=cur();V.pq={lid:L.id,i:0,score:0,pick:null,n:0,target:0};A.pqRound()},
pqRound:()=>{const q=V.pq,L=cur();q.n=Math.floor(Math.random()*L.p.pairs.length);q.target=Math.floor(Math.random()*2);q.pick=null;render();once(L.p.pairs[q.n][q.target],{rate:Math.min(S.speed,1)})},
pqPlay:()=>{const q=V.pq,L=cur();once(L.p.pairs[q.n][q.target],{rate:Math.min(S.speed,1)})},
pqPick:d=>{const q=V.pq,L=cur();q.pick=+d.i;touchEx();const k="l:"+L.id+"-"+q.n;if(q.pick===q.target){q.score++;if(S.rv[k])S.rv[k]=stamp(schedule(S.rv[k],1,dayStr()))}else rvAdd(k,1);save();render()},
pqNext:()=>{const q=V.pq,L=cur();q.i++;if(q.i>=6){const r=S.pron[L.id]||(S.pron[L.id]={});r.quiz=Math.max(r.quiz||0,q.score);stamp(r);save();render()}else A.pqRound()},
ushow:d=>{V.shown[d.k]=1;touchEx();render()}, uchk:d=>{V.shown[d.k]=!V.shown[d.k];render()},
urate:d=>{const c=+d.v;S.use[d.k]=stamp({c});day().it++;touchEx();const rk="u:"+d.k;if(c===0)rvAdd(rk,1);else if(S.rv[rk])S.rv[rk]=stamp(schedule(S.rv[rk],c,dayStr()));
  if(V.step>=0&&S.sess&&S.sess.steps[V.step]&&S.sess.steps[V.step].type==="use"){const st=S.sess.steps[V.step];st.got=(st.got||0)+1;if(st.got>=st.n)stepDone()}save();render()},
role:d=>{if(d.k){const it=useItems(cur()).find(x=>x.k===d.k);V.rpk=d.k;runRole(it.lines,d.k)}else{stop();V.role=+d.r;render()}},
recStart:d=>Rec.start(d.k), recStop:()=>Rec.stopRec(), recPlay:d=>playMine(d.k), recCmp:d=>compareRec(d.k,d.x), recDel:d=>{stop();Rec.drop(d.k);render()},
recSave:async d=>{const c=Rec.clips[d.k];if(!c)return;try{const dl=await window.claude.use("downloads");if(!dl)throw 0;await dl.save({filename:"my-recording-"+d.k.replace(/[^a-z0-9]+/gi,"-")+".webm",data:c.blob})}catch(e){announce(t("rcNoSave"))}},
recTest:async()=>{let ok=false;try{const s=await navigator.mediaDevices.getUserMedia({audio:true});s.getTracks().forEach(x=>x.stop());ok=true}catch(e){}Rec.state=ok?"yes":"no";render()},
/* today's session */
sdone:d=>{const s=S.sess.steps[+d.i];s.done=!s.done;save();render()},
more:()=>{S.sess=buildSession(S,todayL(),15,dueAll().length,dayStr());S.sess.min=S.goal;S.sess.extra=true;save();render()},
sgo:d=>{const i=+d.i,s=S.sess.steps[i],lid=S.sess.lid;V.step=i;
  if(s.type==="break"){s.done=true;V.step=-1;save();render();return}
  if(s.type==="review"){startReview("due");return}
  const sec={shadow:"shadow",vocab:"vocab",dlg:"dlg",gram:"gram",final:"gram",read:"read",pron:"pron",use:"use"}[s.type];
  openL(lid,sec);V.step=i;
  if(s.type==="shadow"){V.range=[s.from,s.n];runShadow()}
  else if(s.type==="vocab"){V.vmode="cards";V.range=[s.from,s.n];runWord()}
  else if(s.type==="dlg"){V.role=-1;V.range=[s.from,s.n];runDlg()}
  else if(s.type==="final")A.finStart();
  else render()},
/* review */
rvStart:d=>startReview(d.m), rvPlay:()=>runReview(hardList()), rvQuit:()=>{stop();V.rq=null;stepDone();save();render()},
rvShow:()=>{const q=V.rq;q.shown=true;touchEx();render();const it=rvItem(q.list[q.i]);if(it)once(it.ans)},
rvGrade:d=>{const q=V.rq;stop();rvGradeKey(q.list[q.i],+d.g);if(+d.g===0&&q.list.length<60)q.list.push(q.list[q.i]);q.done++;q.i++;rvPrep();render()},
rvHear:()=>{const q=V.rq,it=rvItem(q.list[q.i]);once(it.pair[q.target],{rate:Math.min(S.speed,1)})},
rvPick:d=>{const q=V.rq,k=q.list[q.i],it=rvItem(k),ok=it.mcq?+d.i===it.mcq[2]:+d.i===q.target;q.a={pick:+d.i,ok};rvGradeKey(k,ok?1:0);render()},
rvCheck:()=>{grab();const q=V.rq,k=q.list[q.i],it=rvItem(k),val=V.draft.rv||"";if(!val.trim())return;const ok=isRight(val,it.acc);q.a={val,ok};rvGradeKey(k,ok?1:0);render()},
rvNext:()=>{const q=V.rq;q.done++;q.i++;rvPrep();render()},
goCards:d=>{openL(d.l,"vocab");V.vmode="cards";if(/-y\d/.test(d.k))S.syn=true;V.vi=Math.max(0,deck(cur(),S.syn).findIndex(c=>c.k===d.k));render()},
go:d=>{const p=d.to.split(":");if(p[0]==="L")openL(p[1],p[2]);else if(p[0]==="tu")openTutor({lid:p[1],mode:p[2],section:p[2]==="grammar"?"gram":p[2]==="vocab"?"vocab":"path",item:p[3]===""?null:p[3]});else if(p[0]==="rv")startReview(p[1]);else if(p[0]==="st")A.sgo({i:p[1]});else go(d.to)},
/* data */
io:d=>{V.io=d.v;V.imp=null;V.ioErr="";render()},
exp:async()=>{const data=exportData();let saved=false;try{const dl=await window.claude.use("downloads");if(dl){await dl.save({filename:"shadow-english-progress-"+dayStr()+".json",data});saved=true}}catch(e){}
  if(!saved){V.io="export";V.ioText=data;render();const el=document.getElementById("ioOut");if(el){el.focus();el.select()}}else announce(t("ioSaved"))},
impCheck:()=>{const el=document.getElementById("ioIn"),txt=(el&&el.value)||V.ioText||"";const r=parseImport(txt);V.ioErr=r.err||"";V.imp=r.state||null;render()},
impDo:d=>{if(!V.imp)return;snapshot("before-import");S=d.v==="merge"?mergeState(S,V.imp):fillState(V.imp);S.sess=null;V.imp=null;V.io="";V.confirm="";V.notice="imported";save();applyChrome();render()},
ask:d=>{V.confirm=d.v;render()},
confirmYes:()=>{const c=V.confirm;V.confirm="";
  if(c==="reset"){stop();snapshot("before-reset");const keep={lang:S.lang,theme:S.theme,dev:S.dev,voice:S.voice,accent:S.accent,tutor:Object.assign(TU_DEFAULT(),{on:S.tutor.on,consent:S.tutor.consent,ctx:S.tutor.ctx,explain:S.tutor.explain,correct:S.tutor.correct,speak:S.tutor.speak,depth:S.tutor.depth})};S=Object.assign(defaults(),keep);V.ans={};V.draft={};V.tries={};V.rq=null;V.notice="resetDone";save()}
  else if(c==="snap"){try{const sn=JSON.parse(store.get(LS_SNAP));const now=S;S=migrateState(sn.state);store.set(LS_SNAP,JSON.stringify({at:Date.now(),why:"before-restore",state:now}));V.notice="restored";save();applyChrome()}catch(e){V.notice="damaged"}}
  else if(c==="replace"){A.impDo({v:"replace"});return}
  render()}
};
Object.assign(A,tutorActions());
document.addEventListener("click",e=>{const el=e.target.closest("[data-a]");if(!el||el.disabled)return;const f=A[el.dataset.a];if(f)f(el.dataset)});
document.addEventListener("keydown",e=>{const tg=e.target;if(!tg.matches)return;
  if((e.key==="Enter"||e.key===" ")&&tg.matches("span[data-a]")){e.preventDefault();tg.click();return}
  if(e.key==="Escape"&&V.playing){stop();render();return}
  if(e.key==="Enter"&&!e.shiftKey&&tg.id==="in-tutor"){e.preventDefault();A.tuSend();return}
  if(e.key!=="Enter"||!tg.matches("input[data-k]"))return;e.preventDefault();const k=tg.dataset.k;
  if(k==="fin")A.finCheck();else if(k==="rv")A.rvCheck();else if(k==="tuoff")A.tuOffCheck();else if(k==="search")return;else{const b=document.querySelector('[data-a="checkT"][data-k="'+k+'"]');if(b)b.click()}});
let srchT=0;
document.addEventListener("input",e=>{if(e.target.id==="in-search"){clearTimeout(srchT);srchT=setTimeout(()=>{if(!V.playing)render()},250)}});
document.addEventListener("change",e=>{if(e.target.id==="voiceSel"){S.voice=e.target.value;saveSet();once("This is the voice you will hear in the lessons.")}
  if(e.target.id==="ioFile"&&e.target.files&&e.target.files[0]){const fr=new FileReader();fr.onload=()=>{V.ioText=String(fr.result||"");const el=document.getElementById("ioIn");if(el)el.value=V.ioText;A.impCheck()};fr.readAsText(e.target.files[0])}});
document.addEventListener("visibilitychange",()=>{if(document.hidden)saveLocal()});
window.addEventListener("pagehide",()=>{saveLocal()});
applyChrome();if(boot.note==="migrated")save();tutorInit();render();

</script>
</body>
