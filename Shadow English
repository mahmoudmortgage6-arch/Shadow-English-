const hardList=()=>{const o=[];LESSONS.forEach(L=>{for(let i=0;i<17;i++){const x=S.sent[L.id+"-"+i];if(x&&x.rate==="hard")o.push([L.id,i])}});return o};
function dueAll(){const td=dayStr(),o=[];for(const k in S.vocab)if(isDue(S.vocab[k],td))o.push("v:"+k);for(const k in S.rv)if(isDue(S.rv[k],td))o.push(k);return o.filter(k=>!!rvItem(k))}
function hardAll(){const o=[];for(const k in S.rv)if((S.rv[k].bad||0)>0&&(S.rv[k].box||0)<3)o.push(k);for(const k in S.vocab)if(S.vocab[k].box===1)o.push("v:"+k);
  hardList().forEach(([l,i])=>{const k="s:"+l+"-"+i;if(!o.includes(k))o.push(k)});return o.filter(k=>!!rvItem(k))}
/* turn a review key into something that can be shown; unknown or outdated keys return null and are skipped */
function rvItem(k){const kind=k[0],rest=k.slice(2);let m;
  if(kind==="v"){m=rest.match(/^(.+)-(y?)(\d+)(?:_(\d+))?$/);const L=m&&byId(m[1]);if(!L)return null;const c=m[2]?{main:0,i:+m[3],j:+m[4]}:{main:1,i:+m[3]};if(!L.v[c.i]||(!c.main&&!L.x[c.i][2][c.j]))return null;const f=cardInfo(L,c);return {kind,L,cue:f.ar,ans:f.word,sub:f.ipa,tag:"secV"}}
  if(kind==="s"||kind==="d"){m=rest.match(/^(.+)-(\d+)$/);const L=m&&byId(m[1]);if(!L)return null;const i=+m[2];
    if(kind==="s")return L.s[i]?{kind,L,cue:L.s[i][1],ans:plain(L.s[i][0]),tag:"secS"}:null;
    return L.d[i]?{kind,L,ctx:i>0?L.d[i-1][1]:"",cue:L.d[i][2],ans:L.d[i][1],tag:"secD"}:null}
  if(kind==="g"){m=rest.match(/^(.+)-(fill|fix|tr|mcq)-(\d+)$/);const L=m&&byId(m[1]);if(!L)return null;const x=L.g[m[2]][+m[3]];if(!x)return null;
    return m[2]==="mcq"?{kind,L,mcq:x,tag:"tGram"}:m[2]==="tr"?{kind,L,q:x[2],acc:x[3],exp:x[4],hint:S.lang==="ar"?x[1]:x[0],tag:"tGram"}:{kind,L,q:x[0],acc:x[1],exp:x[2],hint:t(m[2]==="fill"?"exFill":"exFix"),tag:"tGram"}}
  if(kind==="l"){m=rest.match(/^(.+)-(\d+)$/);const L=m&&byId(m[1]);const pr=L&&L.p.pairs[+m[2]];return pr?{kind,L,pair:pr,tag:"tPron"}:null}
  if(kind==="u"){const L=byId(rest.split("-u")[0]);const it=L&&useItems(L).find(x=>x.k===rest);return it&&it.model?{kind,L,cue:S.lang==="ar"?it.ar:it.en,src:it.src,ans:it.model,tag:"tUse"}:null}
  return null}
