  const back=c.main?`${big(w[3])}<p class="en center muted">${esc(w[4])}</p>
    <div class="col"><span class="label">${t("ex")}</span><div class="list">${[w[5],w[6]].map(e=>tapRow(e)).join("")}</div></div>
    <div class="col"><span class="label">${t("colloc")}</span><p class="en">${esc(w[9])}</p></div>
    <div class="col"><span class="label">${t("gxTitle")}: ${esc(P(L.g.topic))}</span><div class="list">${x[0].map(e=>`<div class="col" style="gap:6px"><span class="badge" style="align-self:flex-start">${P(SIT[e[0]])}</span>${tapRow(e[1],e[2])}</div>`).join("")}</div></div>
    <div class="col"><span class="label">${t("fam")}</span><div class="list">${x[1].map(e=>`<button class="tap" ${listenBtn(e[0])}><span class="pl">▶</span><span class="grow en">${esc(e[0])} <span class="muted sm">${esc(e[1])}</span></span><span class="ar muted">${esc(e[2])}</span></button>`).join("")}</div></div>
    <div class="col"><span class="label">${t("syn")}</span><p class="sm muted">${t("synWarn")}</p><div class="list">${x[2].map(e=>`<div class="col" style="gap:6px"><button class="tap" ${listenBtn(e[0])}><span class="pl">▶</span><span class="grow en"><b>${esc(e[0])}</b></span><span class="ar muted">${esc(e[1])}</span></button><span class="en sm muted">${esc(e[2])}</span>${e[3]?`<span class="ar sm">${esc(e[3])}</span>`:""}</div>`).join("")}</div></div>
    ${w[8]?`<p class="sm"><span class="label">${t("ant")}</span> <span class="en">${esc(w[8])}</span></p>`:""}
    <div class="col"><span class="label">${t("ownEx")}</span><p class="sm">${t("ownExD").replace("{w}",w[0])}</p>${recW("v:"+k,w[5])}</div>`
   :`${big(f.ar)}<div class="col"><span class="label">${t("ex")}</span><div class="list">${tapRow(x[2][c.j][2])}</div></div><p class="sm muted">${t("synWarn")}</p>`;
  return head+ticks(17,j=>{const v=S.vocab[L.id+"-"+j];return `<button data-a="vi" data-i="${D.findIndex(d=>d.main&&d.i===j)}" aria-label="${t("secV")} ${j+1}" class="${v?((v.box||0)>=3?"done":"hard"):""}${j===i?" cur":""}"></button>`})+
  `<section class="card"><div class="row"><span class="label grow">${V.vi+1} ${t("of")} ${D.length} · ${c.main?esc(w[2]):t("synOf")+' <span class="en">'+esc(w[0])+"</span>"}</span>${c.main?`<button class="star${isBook("v:"+k)?" on":""}" data-a="book" data-k="v:${k}" aria-label="${t("aBook")}" aria-pressed="${isBook("v:"+k)}">${isBook("v:"+k)?"★":"☆"}</button>`:""}</div>
   <p class="word">${esc(f.word)}</p>${f.ipa?`<p class="ipa center">${esc(f.ipa)}</p>`:""}${c.main&&!dr?`<div class="row" style="justify-content:center">${tutorBtn("tuB_word","vocab","vocab",i)}</div>`:""}
   <div class="row" style="justify-content:center"><button class="btn" ${listenBtn(f.word)}>▶ ${t("stListen")}</button><button class="btn primary" data-a="${dr?"stop":"word"}">${dr?"■ "+t("stop"):t("drillW").replace("{n}",S.wreps)}</button>${V.flip||dr?"":`<button class="btn" data-a="flip">${t("show")}</button>`}</div>
