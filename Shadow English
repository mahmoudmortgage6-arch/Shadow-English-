        if(S.arv&&arVoice()){await g(say(L.v[i][3],{lang:"ar",rate:1}));await g(wait(300))}
        d.ex=true;for(const e of L.x[i][0]){d.txt=e[1];d.sub=e[2];render();await g(say(e[1]));if(mode==="repeat")await g(turn(e[1],1.1));else await g(wait(400))}}
      S.dv[key]=i+1;day().it++;save();await g(wait(450))}
    if(!V.failed){if(end>=17){S.dv[key]=0;if(kind==="d"&&i0===0){const rec=S.dlg[L.id]||(S.dlg[L.id]={});rec.done=1;stamp(rec)}}save();
      await g(say(end>=17?"Well done. "+names[kind]+" complete.":"Well done. This part is complete. You stopped at item "+end+".",{rate:1}))}
  }catch(e){if(e!==STOP)console.error(e);return}
  V.failed=false;finish(id)}

async function runRead(mode){const id=begin("read"),g=guard(id),L=cur(),r=L.r;
  try{for(let i=0;i<r.p.length;i++){V.ri=i;V.rmode=mode;render();const x=r.p[i][0];await g(say(x));if(mode===2)await g(turn(x,1.2));else await g(wait(350))}day().it+=r.p.length;stepDone();save()}catch(e){V.ri=-1;if(e!==STOP)console.error(e);return}
  V.ri=-1;finish(id)}
async function runPron(){const id=begin("pron"),g=guard(id),L=cur(),p=L.p;let ok=true;
  try{for(const w of p.w){V.pi=w[0];for(let r=1;r<=3;r++){phase(r+" / 3");if(!await g(say(w[0],{rate:Math.min(S.speed,1)})))ok=false;await g(turn(w[0],1.1))}}
    for(const pr of p.pairs){for(const w of pr){V.pi=w;phase("");await g(say(w,{rate:Math.min(S.speed,1)}));await g(wait(700))}await g(wait(300))}
    for(const x of p.say){const tx=plain(x);V.pi=x;for(let r=1;r<=2;r++){phase(r+" / 2");if(!await g(say(tx)))ok=false;await g(turn(tx))}}
    if(ok){S.pron[L.id]=stamp({done:1});day().it+=11;stepDone();save()}
  }catch(e){V.pi="";if(e!==STOP)console.error(e);return}
  V.pi="";finish(id)}

function deck(L,withSyn){const o=[];L.v.forEach((w,i)=>{o.push({k:L.id+"-"+i,i,main:1});if(withSyn)L.x[i][2].forEach((y,j)=>o.push({k:L.id+"-y"+i+"_"+j,i,j,main:0}))});return o}
const curCard=()=>{const D=deck(cur(),S.syn);if(V.vi>=D.length)V.vi=0;return D[V.vi]};
const cardInfo=(L,c)=>c.main?{word:L.v[c.i][0],ipa:L.v[c.i][1],ar:L.v[c.i][3]}:{word:L.x[c.i][2][c.j][0],ipa:"",ar:L.x[c.i][2][c.j][1]};
/* one word (the open card), or a range of words when a session step asks for it */
async function runWord(){const id=begin("word"),g=guard(id),L=cur(),rg=V.range;
  try{const list=rg?Array.from({length:rg[1]},(_,n)=>rg[0]+n).filter(i=>i<17):[null];
    for(const wi of list){if(wi!=null){V.vi=deck(L,S.syn).findIndex(c=>c.main&&c.i===wi);V.flip=false}
      const c=curCard(),x=L.x[c.i],word=cardInfo(L,c).word,exs=c.main?x[0].map(e=>e[1]):[x[2][c.j][2]];let ok=true;
      for(let r=1;r<=S.wreps;r++){phase(r+" / "+S.wreps);if(!await g(say(word)))ok=false;await g(turn(word,1.1))}
      V.flip=true;for(const e of exs){V.exCur=e;phase(t("ex"));if(!await g(say(e)))ok=false;await g(turn(e,1.1))}
      V.exCur="";if(!ok){V.failed=true;break}
      if(!S.vocab[c.k])S.vocab[c.k]=stamp({box:0,due:dayStr(),seen:1});day().it++;save();if(wi!=null)await g(wait(400))}
    if(rg&&!V.failed)stepDone();
  }catch(e){V.exCur="";if(e!==STOP)console.error(e);return}
  V.exCur="";V.failed=false;finish(id)}
async function runCommute(){const id=begin("commute"),g=guard(id),c=S.cm;let first=true;
  const names=["Sentences","Vocabulary","Conversation"];
  try{for(;;){
    if(V.cmSec>=S.cmLen*60){await g(say("Session complete. Well done.",{rate:1}));V.cmSec=0;break}
    const L=LESSONS[c.l];
    if(first||c.i===0){await g(say("Lesson "+L.day+". "+L.title[0]+". "+names[c.p]+".",{rate:1}));await g(wait(500));first=false}
    render();let ok=true;
    if(c.p===0){const x=plain(L.s[c.i][0]),N=S.rmode==="fixed"?S.reps:repsFor(S,S.sent[L.id+"-"+c.i],false).model;let m=0;for(let r=0;r<N;r++){if(await g(say(x)))m++;else ok=false;await g(turn(x))}if(ok)touchSent(L.id,c.i,m,N)}
    else if(c.p===1){const w=L.v[c.i],x=L.x[c.i];
      const drill=async(word,ar,exs,k)=>{for(let r=0;r<S.wreps;r++){if(!await g(say(word)))ok=false;await g(turn(word,1.1))}if(S.arv&&arVoice()){await g(say(ar,{lang:"ar",rate:1}));await g(wait(300))}for(const e of exs){if(!await g(say(e)))ok=false;await g(turn(e,1.1))}if(ok&&!S.vocab[k])S.vocab[k]=stamp({box:0,due:dayStr(),seen:1})};
      await drill(w[0],w[3],x[0].map(e=>e[1]),L.id+"-"+c.i);
      if(S.syn){for(let j=0;j<x[2].length;j++){await g(say("Related word.",{rate:1}));await drill(x[2][j][0],x[2][j][1],[x[2][j][2]],L.id+"-y"+c.i+"_"+j)}}}
    else{const d=L.d[c.i];for(let r=0;r<S.dreps;r++){if(!await g(say(d[1],{pitch:d[0]?0.8:1.12})))ok=false;await g(turn(d[1],1.1))}}
    if(!ok)break;
    c.i++;if(c.i>=17){c.i=0;if(c.p===2){const rec=S.dlg[L.id]||(S.dlg[L.id]={});rec.done=1;stamp(rec)}c.p++;if(c.p>2){c.p=0;c.l=(c.l+1)%LESSONS.length}}
    save()}
  }catch(e){if(e!==STOP)console.error(e);return}
  finish(id)}
/* role-play task in "Use it yourself": the voice says the A lines, the B lines are the learner's turns */
async function runRole(lines,key){const id=begin("role"),g=guard(id);
  try{for(let i=0;i<lines.length;i++){V.rpi=i;if(i%2===0){phase("line");await g(say(lines[i],{pitch:1.12}));await g(wait(300))}else{phase("you");await g(turn(lines[i],1.6))}}}catch(e){V.rpi=-1;if(e!==STOP)console.error(e);return}
  V.rpi=-1;V.shown[key]=1;finish(id)}
/* first listening in "Understand": the whole conversation once, text hidden */
async function runUnderstand(){const id=begin("und"),g=guard(id),L=cur();let ok=true;
  try{for(let i=0;i<17;i++){V.di=i;render();if(!await g(say(L.d[i][1],{pitch:L.d[i][0]?0.8:1.12})))ok=false;await g(wait(350))}}catch(e){V.di=-1;if(e!==STOP)console.error(e);return}
  V.di=-1;if(ok)V.und.heard=(V.und.heard||0)+1;finish(id)}

