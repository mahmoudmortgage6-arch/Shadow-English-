  if(st.s<17)o.push([t("nx_s").replace("{t}",P(L.title)),t("nx_sW").replace("{n}",st.s),"L:"+L.id+":shadow"]);
  else if(st.v<17)o.push([t("nx_v").replace("{t}",P(L.title)),t("nx_vW").replace("{n}",st.v),"L:"+L.id+":vocab"]);
  else if(!st.d)o.push([t("nx_d"),t("nx_dW"),"L:"+L.id+":dlg"]);
  else if(!st.g)o.push([t("nx_g").replace("{t}",P(L.g.topic)),t("nx_gW"),"L:"+L.id+":gram"]);
  if(h)o.push([t("nx_h").replace("{n}",h),t("nx_hW"),"rv:hard"]);
  const part=LESSONS.find(x=>{const s=stat(x);return s.core&&!s.full});
  if(part){const s=stat(part),miss=[!s.r&&t("tRead"),!s.p&&t("tPron"),!s.u&&t("tUse")].filter(Boolean).join(" · ");o.push([t("nx_full").replace("{n}",part.day),miss,"L:"+part.id+":"+(!s.r?"read":!s.p?"pron":"use")])}
  const nd=S.tutor.profileOn?topNeeds(S.tutor.profile,1)[0]:null;if(nd&&nd.n>=2&&byId(nd.lid))o.push([t("nx_need").replace("{t}",nd.label),t("nx_needW").replace("{n}",nd.n),"tu:"+nd.lid+":"+(nd.type==="vocab"?"vocab":nd.type==="grammar"?"grammar":"ask")+":"+(nd.type==="vocab"?Math.max(0,byId(nd.lid).v.findIndex(w=>w[0]===nd.label)):"")]);
  if(!o.length)o.push([t("r0"),"",""]);return o.slice(0,5)}
function searchRes(q){q=q.trim().toLowerCase();const o=[];if(q.length<2)return o;
  for(const L of LESSONS){L.s.forEach((x,i)=>{if(o.length<40&&(plain(x[0]).toLowerCase().includes(q)||x[1].includes(q)))o.push([L,"shadow",i,plain(x[0]),x[1]])});
