}}

/* ---------- actions ---------- */
function rateWord(k,gr){S.vocab[k]=stamp(schedule(Object.assign({seen:1},S.vocab[k]),gr,dayStr()));day().it++;touchEx();save()}
function rvAdd(k,dueOffset){const r=S.rv[k]||{box:0,n:0,bad:0};r.bad=(r.bad||0)+1;r.box=Math.min(r.box||0,1);r.due=dayStr(dueOffset||0);S.rv[k]=stamp(r)}
function rvGradeKey(k,g){if(k[0]==="v"){rateWord(k.slice(2),g);return}S.rv[k]=stamp(schedule(S.rv[k],g,dayStr()));
  if(k[0]==="s"){const r=S.sent[k.slice(2)];if(r&&g!==1){r.rate=g===0?"hard":"easy";stamp(r)}}day().it++;touchEx();save()}
function startReview(mode){const due=dueAll(),hard=hardAll(),cap=reviewCap(S.goal);let list=mode==="due"?due:mode==="quick"?(due.length?due:hard).slice(0,10):mode==="hard"?hard:shuffle([...new Set([...due,...hard])]);
  list=list.slice(0,mode==="quick"?10:cap);if(!list.length)return;stop();V.rq={list,i:0,shown:false,a:null,done:0,mode};V.draft.rv="";rvPrep();V.tab="review";render();window.scrollTo(0,0)}
function rvPrep(){const q=V.rq;if(!q||q.i>=q.list.length)return;const it=rvItem(q.list[q.i]);q.shown=false;q.a=null;q.target=it&&it.pair?Math.floor(Math.random()*2):0;V.draft.rv="";const inp=document.getElementById("in-rv");if(inp)inp.value=""}
function quizOpts(){const q=V.q,L=cur(),w=L.v[q.items[q.i]];if(q.type==="own"){q.opts=[];return}
  const f=q.type==="en2ar"?3:0;q.opts=shuffle([w[f],...shuffle(L.v.filter(x=>x[f]!==w[f]).map(x=>x[f])).slice(0,3)])}
function announce(msg){const el=document.getElementById("live");if(el){el.textContent="";setTimeout(()=>{el.textContent=msg},30)}}
const setOpt=(k,v)=>{S[k]=v;saveSet();render()};

