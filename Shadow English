  if(c[0]==="try"&&se.last&&se.last.question){const el=document.getElementById("in-tutor");if(el)el.focus();return}
  if(c[0]==="talk"&&se.mode!=="dialogue"){se.mode="dialogue";se.section="dlg";se.step="free";se.hist=[];tutorSend("step","Start the free conversation.");return}
  if(c[0]==="work"&&tu.ctx==="lesson"){/* one-off workplace example, the saved preference is not changed */}
