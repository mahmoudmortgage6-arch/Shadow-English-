  ${a?`<p class="fb ${a.ok?"good":"poor"}" role="status">${a.ok?t("correct"):t("incorrect")+' <span class="en">'+esc(acc[0])+"</span>"}</p>
    ${acc.length>1?`<p class="sm muted">${t("alsoOk")} <span class="en">${acc.slice(1).map(esc).join(" · ")}</span></p>`:""}
