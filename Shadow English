/* ---------- AI tutor: an optional teaching layer over the existing lessons ----------
   Providers answer one request: ask(messages, {signal, tier}) -> Promise<parsed JSON or text>.
   1. "host": the page's ask-Claude capability (runs on the viewer's own Claude account, after their consent).
   2. "backend": an authorised server of your own. Off until TUTOR_BACKEND is set; the key stays on that server, never in this file.
   With no provider the tutor screen shows the lesson's written material and app-checked practice, and says so. */
const TUTOR_BACKEND=null; /* e.g. {url:"https://your-server.example/tutor"} */
let tuHost=null,tuCtl=null,tuSR=null;
const hostTutor={id:"host",has:()=>!!tuHost,ask:(messages,o)=>tuHost.json(messages,{cache:false,signal:o.signal,modelTier:o.tier})};
const backendTutor={id:"backend",has:()=>!!(TUTOR_BACKEND&&TUTOR_BACKEND.url),
  ask:async(messages,o)=>{const r=await fetch(TUTOR_BACKEND.url,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({messages,tier:o.tier}),signal:o.signal});if(!r.ok)throw {code:r.status===429?"rate_limited":"upstream_error"};return r.json()}};
const TUTOR_PROVIDERS=[hostTutor,backendTutor];
const tutorProvider=()=>TUTOR_PROVIDERS.find(p=>p.has())||null;
function tutorInit(){V.ai="checking";(async()=>{try{const c=window.claude;tuHost=c&&c.use?await c.use("sample"):null}catch(e){tuHost=null}
  V.ai=tutorProvider()?"ready":"none";if(V.tab==="tutor"){if(V.tu&&tutorLive()&&!V.tu.started)tutorSend("start");else if(!V.playing)render()}})()}
/* live AI teaching needs: a provider, the feature switched on, the learner's consent, and no refusal in this view */
const tutorCan=()=>V.ai==="ready"&&S.tutor.on&&!V.aiOff;
const tutorLive=()=>tutorCan()&&S.tutor.consent;
const SR=()=>window.SpeechRecognition||window.webkitSpeechRecognition||null;

const teacherIcon=n=>`<svg width="${n||20}" height="${n||20}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5 12 4l9.5 4.5L12 13z"/><path d="M6.5 10.6v4.2c1.5 1.6 3.4 2.4 5.5 2.4s4-.8 5.5-2.4v-4.2"/><path d="M21.5 8.5v5"/></svg>`;
function tutorBtn(label,mode,section,item,cls){return `<button class="btn tutorb ${cls||""}" data-a="tutor" data-m="${mode}" data-s="${section||mode}"${item==null?"":` data-i="${item}"`}>${teacherIcon(18)}<span>${t(label)}</span></button>`}

/* ----- session ----- */
function openTutor(o){const L=byId(o.lid||V.lid);if(!L)return;stop();V.lid=L.id;
  V.tu={lid:L.id,mode:TUTOR_MODES.includes(o.mode)?o.mode:"ask",section:o.section||o.mode,item:o.item==null?null:+o.item,ret:V.tab==="lesson"?V.sec:(o.section&&TABS.some(x=>x[0]===o.section)?o.section:"path"),
    msgs:[],hist:[],busy:false,err:"",stage:0,step:"explain",role:1,verdicts:[],ok:0,almost:0,bad:0,answers:0,paused:false,ended:false,started:false,removed:0,needs:[],t0:Date.now(),last:null,lastSend:null,off:null,sum:false};
  V.tuDraft="";V.tab="tutor";render();window.scrollTo(0,0);focusMain();
  if(tutorLive())tutorSend("start")}
const tuL=()=>byId(V.tu.lid);
function tuTitle(){const se=V.tu,L=tuL(),sec={lesson:"tuM_lesson",grammar:"tGram",vocab:"secV",dialogue:"tDlg",sentence:"secS",reading:"tRead",pron:"tPron",use:"tUse",ask:"tuM_ask"}[se.mode];let it="";
  if(se.mode==="vocab")it=L.v[se.item||0][0];else if(se.mode==="grammar")it=L.g.topic[0];else if(se.mode==="sentence")it=se.item>=100?L.d[se.item-100][1]:plain(L.s[se.item||0][0]);else if(se.mode==="pron")it=L.p.t[0];else if(se.mode==="reading")it=L.r.t[0];
  return {sec:t(sec),it}}
function stageLine(se){if(se.mode==="lesson")return "STAGE "+(se.stage+1)+" of 10: "+({welcome:"welcome the learner and state the lesson objective in one or two sentences, then ask if they are ready or what they already know",conversation:"introduce the conversation: who, where, why. Ask one question about the situation",vocabulary:"teach two or three important words from the lesson, then one quick check",grammar:"explain the grammar rule very briefly with two examples, then one guided task",pronunciation:"show the lesson's sound focus with two words; ask the learner to listen and repeat in the app and tell you how it went",sentences:"practise two useful sentences from the lesson: ask the learner to change one part",dialogue:"a short interactive dialogue on the lesson situation: you say one line in \"say\" and wait",check:"ask one understanding question about the lesson",feedback:"give corrective feedback on what the learner found hard in this session, kindly and specifically",summary:"summarise in three short lines and recommend the next practice activity; nextStep \"end\""})[TUTOR_STAGES[se.stage]]+".";
  if(se.mode==="dialogue"){const L=tuL();if(se.step==="role")return "STEP: guided role-play. You are "+L.who[1-se.role]+"; the learner is "+L.who[se.role]+". Say ONLY your next line from the script in \"say\" and wait. If the learner's line differs from the script but fits, accept it.";
    if(se.step==="free")return "STEP: free conversation. Situation: "+SCEN_TEXT[S.tutor.scen]+". Style: "+LEVEL_TEXT[S.tutor.clevel]+". Say one short line in \"say\" and wait.";
    return "STEP: explain the conversation briefly (who speaks, the situation, why), then two key expressions with a more formal or informal alternative for one of them, then ask one question about it."}
  return ""}
async function tutorSend(kind,text,instr){const se=V.tu;if(!se||se.busy||se.paused||se.ended&&kind!=="end")return;const prov=tutorProvider();if(!prov||!tutorLive())return;
  let body;
  if(kind==="start")body="[START] Begin teaching now. Do not ask which lesson this is.";
  else if(kind==="learner"||kind==="check"){const sc=scrubText(text);if(!sc.text)return;if(sc.removed)se.removed+=sc.removed;
    body=(kind==="check"?"[CHECK] The learner asks you to correct this sentence of theirs: ":"[LEARNER] ")+sc.text;se.msgs.push({who:"s",text:sc.text,removed:sc.removed});se.answers++;day().it++;touchEx()}
  else if(kind==="command")body="[COMMAND] "+instr;
  else if(kind==="step")body="[NEXT] "+(instr||"Continue.");
  else if(kind==="end")body="[END] The learner is ending the session. In explanation give a summary of at most three short lines: what went well, what to practise next"+(S.tutor.correct==="end"?", and every correction you held back":"")+". No new question. nextStep \"end\".";
  const diff=DIFF_TEXT[tutorDifficulty(se)],st=stageLine(se),content=[st,diff,body].filter(Boolean).join("\n");
  const ctx=tutorContext(S,tuL(),{mode:se.mode,section:se.section,item:se.item});
  const messages=[{role:"user",content:tutorRules(ctx,{known:ctx.learningNeeds})},...se.hist.slice(-10),{role:"user",content}];
  se.busy=true;se.err="";se.started=true;se.lastSend=[kind,text,instr];stop();tuCtl=new AbortController();const mine=tuCtl;render();tuScroll();
  let raw=null,code="";
  try{raw=await prov.ask(messages,{signal:mine.signal,tier:S.tutor.depth})}
  catch(e){code=(e&&e.code)||"upstream_error";if(code==="invalid_json"&&e.text)raw=e.text}
  if(V.tu!==se||mine!==tuCtl)return;
  se.busy=false;
  if(["not_granted","sampling_disabled","not_declared","capability_disabled","capability_removed"].includes(code)){V.aiOff=code;if(kind==="learner"||kind==="check"){se.msgs.pop();se.answers--;tuSetDraft(text)}render();return}
  const reply=raw==null?null:validateReply(raw);
  if(!reply){se.err=code==="cancelled"?"":code==="rate_limited"?"rate":code==="prompt_too_large"?"big":code?"net":"bad";if(code==="cancelled"&&(kind==="learner"||kind==="check")){se.msgs.pop();se.answers--;tuSetDraft(text)}render();return}
  se.hist.push({role:"user",content},{role:"assistant",content:replyDigest(reply)});
  se.msgs.push({who:"t",r:reply,end:kind==="end"});se.last=reply;tutorLearn(se,reply);
  if(kind==="end"){se.sum=true}
  save();if(V.tab!=="tutor")return;render();tuScroll();if(S.tutor.speak&&!se.paused)tutorSpeak(reply)}
/* what the app itself records from a reply: verdict counts, the learning profile, and review scheduling for a missed lesson word */
function tutorLearn(se,r){const L=tuL(),p=S.tutor.profile,now=Date.now();
  if(r.feedback){se.verdicts.push(r.feedback.verdict);if(r.feedback.verdict==="correct")se.ok++;else if(r.feedback.verdict==="almost")se.almost++;else se.bad++;
    if(r.feedback.verdict==="incorrect"&&S.tutor.profileOn){
      if(se.mode==="vocab"){const k=L.id+"-"+(se.item||0);se.needs.push(noteNeed(p,"vocab",L.id,L.v[se.item||0][0],now));S.vocab[k]=stamp(schedule(Object.assign({seen:1},S.vocab[k]),0,dayStr()))}
      else if(r.feedback.category==="grammar"||se.mode==="grammar")se.needs.push(noteNeed(p,"grammar",L.id,L.g.topic[0],now))}}
  if(S.tutor.profileOn)r.needs.forEach(n=>se.needs.push(noteNeed(p,n.type,L.id,n.label,now)));
  if(se.mode==="lesson"&&r.stageDone&&se.stage<9)se.stageReady=true;
  p.acts++}
function tutorSpeak(r){const txt=r.say||(r.question&&r.question.en)||(r.examples[0]&&r.examples[0].en)||"";if(txt)once(txt)}
function tuSetDraft(tx){V.tuDraft=tx;const el=document.getElementById("in-tutor");if(el)el.value=tx}
function tuScroll(){setTimeout(()=>{const el=document.getElementById("tuEnd");if(el&&el.scrollIntoView)el.scrollIntoView({block:"end"})},40)}
function tutorClose(silent){const se=V.tu;if(!se)return;if(tuCtl)tuCtl.abort();tuCtl=null;if(!silent)stop();srStop();
  if(se.answers>0||se.msgs.length>1){const p=S.tutor.profile;p.sessions.push({t:se.t0,lid:se.lid,mode:se.mode,answers:se.answers,ok:se.ok,almost:se.almost,bad:se.bad});p.sessions=p.sessions.slice(-40);save()}
  if(silent){V.tu=null;return}
  const ret=se.ret;V.tu=null;V.tab="lesson";V.sec=ret||"path";render();window.scrollTo(0,0);focusMain()}
/* where to go next, decided by the app from what is still open in this lesson */
function tutorNext(se){const L=tuL(),st=stat(L);
  if(se.mode==="vocab")return ["tuN_cards","vocab"];if(se.mode==="grammar")return st.g?["tuN_use","use"]:["tuN_gram","gram"];if(se.mode==="dialogue")return ["tuN_role","dlg"];
  if(se.mode==="pron")return ["tuN_pron","pron"];if(se.mode==="reading")return ["tuN_read","read"];if(se.mode==="use")return ["tuN_use","use"];
  return st.s<17?["tuN_sent","shadow"]:st.v<17?["tuN_cards","vocab"]:!st.d?["tuN_role","dlg"]:!st.g?["tuN_gram","gram"]:["tuN_use","use"]}

/* ----- written material and app-checked practice, used when live AI teaching is not available ----- */
function tutorOffline(L,mode,item){const g=L.g,B=[],P=[];
  const gramB=()=>{B.push({h:P2(g.topic),ar:g.ar[0],en:g.en[0]});B.push({h:t("forms"),list:g.forms.map(f=>({en:f[2]+" — "+f[3],ar:S.lang==="ar"?f[1]:f[0]}))});B.push({h:t("errors"),list:g.err.map(e=>({en:"✗ "+e[0]+"  →  ✓ "+e[1],ar:e[2]}))});
    g.fill.forEach(x=>P.push({q:x[0],acc:x[1],exp:x[2],hint:t("exFill")}));g.tr.forEach(x=>P.push({q:x[2],acc:x[3],exp:x[4],hint:S.lang==="ar"?x[1]:x[0]}))};
  if(mode==="grammar")gramB();
  else if(mode==="vocab"){const w=L.v[item||0],x=L.x[item||0];B.push({h:w[0]+"  "+w[1]+"  ·  "+w[2],ar:w[3],en:w[4]});B.push({h:t("ex"),list:[w[5],w[6],...x[0].map(e=>e[1])].map(e=>({en:e,play:1}))});B.push({h:t("colloc"),en:w[9]});
    B.push({h:t("syn"),ar:t("synWarn"),list:x[2].map(e=>({en:e[0]+" — "+e[2],ar:e[1]}))});const gp=gapOf(w);if(gp)P.push({q:gp,acc:[w[0]],exp:w[3],hint:t("vqQ_gap")})}
  else if(mode==="dialogue")B.push({h:L.who.join(" · "),list:L.d.map(d=>({en:L.who[d[0]]+": "+d[1],ar:d[2],play:d[1]}))});
  else if(mode==="sentence"){const fromD=item>=100,i=fromD?item-100:(item||0);B.push(fromD?{h:L.who[L.d[i][0]],en:L.d[i][1],ar:L.d[i][2],play:L.d[i][1]}:{h:t("secS")+" "+(i+1),en:plain(L.s[i][0]),ar:L.s[i][1]+" — "+L.s[i][2],play:plain(L.s[i][0])})}
  else if(mode==="reading")B.push({h:L.r.t[0],list:L.r.p.map(x=>({en:x[0],ar:x[1],play:1}))});
  else if(mode==="pron"){B.push({h:P2(L.p.t),ar:L.p.how});B.push({h:t("prTrap"),ar:L.p.trap});B.push({h:t("prWords"),list:L.p.w.map(w=>({en:w[0]+"  "+w[1],play:w[0]}))})}
  else if(mode==="use"){const it=useItems(L)[Math.max(0,item||0)];if(it)B.push({h:t(it.g),en:it.en,ar:it.ar})}
  else{B.push({h:t("pwGoal"),ar:g.obj[0][1],en:g.obj[0][0]});gramB();B.push({h:t("secV"),list:L.v.slice(0,8).map(w=>({en:w[0],ar:w[3],play:w[0]}))})}
  return {blocks:B,practice:P}}
const P2=p=>p[S.lang==="ar"?1:0];

/* ----- voice input: only the browser's own speech recognition, and only where it exists ----- */
function srStart(){const C=SR();if(!C||V.sr==="on")return;stop();let r;try{r=new C()}catch(e){V.sr="no";render();return}
  tuSR=r;r.lang=S.accent==="UK"?"en-GB":"en-US";r.interimResults=false;r.maxAlternatives=1;
  r.onresult=e=>{const tx=e.results&&e.results[0]&&e.results[0][0]?e.results[0][0].transcript:"";if(tx){grab();tuSetDraft(((V.tuDraft||"")+" "+tx).trim())}};
  r.onerror=e=>{if(e&&(e.error==="not-allowed"||e.error==="service-not-allowed"||e.error==="audio-capture"))V.sr="no";else V.sr="idle";render()};
  r.onend=()=>{if(V.sr==="on")V.sr="idle";tuSR=null;render()};
  V.sr="on";try{r.start()}catch(e){V.sr="no"}render()}
function srStop(){try{tuSR&&tuSR.stop()}catch(e){}if(V.sr==="on")V.sr="idle"}

