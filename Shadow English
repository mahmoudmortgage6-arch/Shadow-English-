/* American pronunciation, one unit per lesson: t = title [en, ar]; how = how to make the sound (Arabic); trap = the usual mistake for Arabic speakers (Arabic);
   w = 8 words [word, IPA]; pairs = minimal pairs [a, b]; say = 3 practice sentences (may use *stress* and ‿ linking marks). */
const PRON={
l1:{t:["The three sounds of final -s","الأصوات الثلاثة لحرف s في آخر الكلمة"],
how:"حرف s في آخر الفعل له ثلاثة أصوات: /s/ بعد الأصوات المهموسة مثل k و t و p، و /z/ بعد الأصوات المجهورة وبعد حروف العلة، و /ɪz/ (مقطع إضافي) بعد s و z و sh و ch و x.",
trap:"الخطأ الشائع: نطقها /s/ دائمًا. قل goes بصوت z واضح، ولا تنسَ المقطع الإضافي في watches و brushes.",
w:[["wakes","/weɪks/"],["gets","/ɡets/"],["drinks","/drɪŋks/"],["goes","/ɡoʊz/"],["leaves","/liːvz/"],["drives","/draɪvz/"],["watches","/ˈwɑːtʃɪz/"],["brushes","/ˈbrʌʃɪz/"]],
pairs:[["ice","eyes"],["price","prize"],["rice","rise"]],
say:["He wakes up at six and gets dressed.","She goes to work and drives the kids to school.","He brushes his teeth and watches the news."]},

d02:{t:["/p/ and /b/","الفرق بين /p/ و /b/"],
how:"الصوتان يُنطقان بضمّ الشفتين ثم فتحهما. في /p/ لا يهتز الحلق ويخرج نَفَس قوي من الهواء، وفي /b/ يهتز الحلق ولا يخرج نَفَس. ضع كفّك أمام فمك: يجب أن تشعر بالهواء مع pen ولا تشعر به مع Ben.",
trap:"العربية ليس فيها /p/، فيتحول people إلى «بيبول» و park إلى «بارك». ادفع الهواء بقوة في أول الكلمة.",
