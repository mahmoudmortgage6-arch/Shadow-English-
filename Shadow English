<script>/* Lesson data. Each lesson MUST have exactly 17 sentences (s), 17 words (v), 17 dialogue turns (d).
   s: [english (*stress*, ‿ linking), arabic, pronunciation tip]
   v: [word, ipa, part of speech, arabic, meaning, example 1, example 2, synonyms, antonyms, collocations]
   d: [speaker index, english, arabic] */
const LESSONS = [
{
 id:"l1", level:"A2", track:["General English","إنجليزي عام"],
 title:["My Morning Routine","روتيني الصباحي"],
 s:[
 ["I *wake* up‿at *six* o'clock every *morning*.","أستيقظ في الساعة السادسة كل صباح.","اربط up‿at فتُسمع «أَ-پات». لا تتوقف بين الكلمتين."],
 ["I *turn* off the *alarm* and *get*‿out‿of *bed*.","أطفئ المنبّه وأنهض من السرير.","get out of تُنطق متصلة وسريعة: «جِدَاوْدَڤ»."],
 ["I *brush* my *teeth* and *wash* my *face*.","أغسل أسناني ووجهي.","صوت th في teeth: طرف اللسان بين الأسنان، وليس «س» ولا «ت»."],
 ["Then I *take*‿a *quick* *shower*.","ثم آخذ دُشًّا سريعًا.","take‿a تُنطق «تيكَ». صوت sh في shower مثل «ش»."],
 ["I *get* *dressed* and *comb* my *hair*.","أرتدي ملابسي وأمشّط شعري.","حرف b في comb صامت: «كوم». و dressed تنتهي بصوت «ت»."],
 ["My *wife* *makes* *breakfast* for the *family*.","زوجتي تُعدّ الفطور للأسرة.","breakfast تُنطق «بْرِكْفَسْت» وليس «بريك فاست»."],
 ["I *usually* have *eggs*, *bread*, and‿a *cup*‿of *tea*.","عادةً أتناول بيضًا وخبزًا وكوب شاي.","usually فيها صوت «ج» المعطّشة الخفيفة /ʒ/. و cup of تُسمع «كَپَڤ»."],
 ["I *don't* *drink* *coffee* in the *morning*.","لا أشرب القهوة في الصباح.","اضغط على don't لأنها تحمل النفي، وانطقها «دونت» بحرف o طويل."],
 ["I *check* my *phone* for *new* *messages*.","أتفقّد هاتفي بحثًا عن رسائل جديدة.","messages ثلاثة مقاطع: «مِ-سِ-جِز»."],
 ["My *children* get *ready* for *school*.","أولادي يستعدّون للمدرسة.","school تبدأ بـ «سْك» مباشرة، بدون إضافة «إِ» في أولها."],
 ["We *leave* the *house* at *seven* *thirty*.","نغادر البيت في السابعة والنصف.","leave بصوت «ي» طويل، بعكس live القصيرة. و thirty تبدأ بصوت th."],
 ["I *drive* my *kids* to *school* *first*.","أوصّل أولادي إلى المدرسة أولًا.","first: لا تضف حرف علّة بين r و s و t."],
 ["Then I *go* to *work* by *car*.","ثم أذهب إلى العمل بالسيارة.","work تُنطق «وِرك» وتختلف عن walk «ووك»."],
