/* ----- vocabulary ----- */
function vVocab(L){const head=`<div class="seg"><button data-a="vmode" data-m="cards" aria-selected="${V.vmode==="cards"}">${t("cards")}</button><button data-a="vmode" data-m="quiz" aria-selected="${V.vmode==="quiz"}">${t("vqTab")}</button></div>`;
  if(V.vmode==="quiz")return head+vQuiz(L);
  const D=deck(L,S.syn),c=curCard(),i=c.i,w=L.v[i],x=L.x[i],f=cardInfo(L,c),k=c.k,st=S.vocab[k],td=dayStr(),dr=V.what==="word";
  const tapRow=(en,sub)=>`<button class="tap" ${listenBtn(en)}><span class="pl">▶</span><span class="grow"><span class="en" style="display:block${V.exCur===en?";font-weight:700":""}">${esc(en)}</span>${sub?`<span class="ar muted sm" style="display:block">${esc(sub)}</span>`:""}</span></button>`;
