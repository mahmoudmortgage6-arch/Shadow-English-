/* active recall: four question types built from the lesson's own words */
const QTYPES=[["en2ar","vqA"],["ar2en","vqB"],["gap","vqC"],["own","vqD"]];
const gapOf=w=>{const re=new RegExp("\\b"+w[0].replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+"\\b","i");return re.test(w[5])?w[5].replace(re,"_____"):null};
function vQuiz(L){const q=V.q,rec=S.vq[L.id],ty=V.qtype||"en2ar";
  const pickT=`<div class="col"><span class="label">${t("vqType")}</span><div class="row">${QTYPES.map(([k,l])=>chip(t(l),"qtype",ty===k,`data-v="${k}"`)).join("")}</div></div>`;
  if(!q||q.lid!==L.id)return `<section class="card">${pickT}<p class="sm muted">${t("vqD_"+ty)}</p>${rec?`<p class="muted sm">${t("best")}: ${rec.best}/10 · ${t("last")}: ${rec.last}/10</p>`:""}<button class="btn primary" data-a="quizStart">${t("startQuiz")}</button></section>`;
  if(q.i>=q.items.length)return `<section class="card center"><span class="label">${t(q.type==="own"?"vqOwnDone":"score")}</span>${q.type==="own"?"":`<p class="word">${q.score} / ${q.items.length}</p>`}<button class="btn primary" data-a="quizStart">${t("retry")}</button><button class="btn ghost" data-a="quizQuit">${t("vqOther")}</button></section>`;
  const w=L.v[q.items[q.i]],right=q.type==="en2ar"?w[3]:w[0];
  if(q.type==="own")return `<section class="card"><span class="label">${q.i+1} ${t("of")} ${q.items.length} · ${t("vqD")}</span><p class="word">${esc(w[0])}</p><p class="ar center muted">${esc(w[3])}</p><p>${t("ownExD").replace("{w}",w[0])}</p>
    ${q.pick!=null?`<div class="col"><span class="label">${t("vqModel")}</span><button class="tap" ${listenBtn(w[5])}><span class="pl">▶</span><span class="en grow">${esc(w[5])}</span></button></div><button class="btn primary" data-a="quizNext">${t("next")}</button>`:`${recW("q:"+L.id+"-"+q.items[q.i],w[5])}<button class="btn primary" data-a="quizPick" data-i="0">${t("vqSaid")}</button>`}</section>`;
  const head=q.type==="en2ar"?`<p class="word">${esc(w[0])}</p><div class="row" style="justify-content:center"><button class="btn" ${listenBtn(w[0])}>▶ ${t("stListen")}</button></div>`
    :q.type==="ar2en"?`<p class="ar center" style="font-size:26px;font-weight:700">${esc(w[3])}</p>`:`<p class="en" style="font-size:20px;font-weight:600">${esc(gapOf(w))}</p>`;
  return `<section class="card"><span class="label">${q.i+1} ${t("of")} ${q.items.length} · ${t("vqQ_"+q.type)}</span>${head}
   <div class="opts">${q.opts.map((o,j)=>`<button class="opt ${q.type==="en2ar"?"ar":"en"}${q.pick!=null?(o===right?" good":(j===q.pick?" poor":"")):""}" data-a="quizPick" data-i="${j}" ${q.pick!=null?"disabled":""}>${esc(o)}</button>`).join("")}</div>
   ${q.pick!=null?`<p class="fb ${q.opts[q.pick]===right?"good":"poor"}" role="status">${q.opts[q.pick]===right?t("correct"):t("incorrect")+' <span class="'+(q.type==="en2ar"?"ar":"en")+'">'+esc(right)+"</span>"}</p>${q.type==="gap"?`<p class="en sm muted">${esc(w[5])}</p>`:""}<button class="btn primary" data-a="quizNext">${t("next")}</button>`:""}</section>`}

/* ----- conversation ----- */
function mcqOrder(key,n){return V.perm[key]||(V.perm[key]=shuffle([...Array(n).keys()]))}
function mcqBlock(key,x,n,en){const a=V.ans[key],ord=mcqOrder(key,x[1].length);
  return `<div class="q"><p class="en"><b>${n}.</b> ${esc(x[0])}</p><div class="opts">${ord.map(j=>`<button class="opt en${a!=null?(j===x[2]?" good":(j===a?" poor":"")):""}" data-a="pick" data-k="${key}" data-i="${j}" data-c="${x[2]}" ${a!=null?"disabled":""}>${esc(x[1][j])}</button>`).join("")}</div>${a!=null?(en?`<p class="fb ${a===x[2]?"good":"poor"}" role="status">${a===x[2]?t("correct"):t("incorrect")+' <span class="en">'+esc(x[1][x[2]])+"</span>"}</p><p class="sm muted">${t("rdFrom")} <span class="en">“${esc(x[3])}”</span></p>`:`<p class="fb ${a===x[2]?"good":"poor"}" role="status">${a===x[2]?t("correct"):t("incorrect")+' <span class="en">'+esc(x[1][x[2]])+"</span>"}</p><p class="ar sm"><b>${t("why")}</b> ${esc(x[3])}</p>`):""}</div>`}
function vDlg(L){const playing=V.what==="dlg",rp=V.role!==-1;
  return `<section class="card"><div class="col"><span class="label">${t("dlgMode")}</span><div class="row">${chip(t("dlgCont"),"role",V.role===-1,'data-r="-1"')}${L.who.map((w,j)=>chip(t("dlgAs")+" "+w,"role",V.role===j,`data-r="${j}"`)).join("")}</div><p class="sm muted">${t(rp?"dlgRpD":"dlgContD")}</p></div>
   ${rp?"":`<div class="col"><span class="label">${t("dreps")}</span><div class="row">${[1,2,3,7].map(v=>chip(v+"x","dreps",S.dreps===v,`data-v="${v}"`)).join("")}</div></div>`}
   <div class="row"><button class="btn primary" data-a="${playing?"stop":"dlg"}">${playing?"■ "+t("stop"):"▶ "+t(rp?"dlgStartRp":"playDlg")}</button>${chip(t("trans"),"dtr",V.dtr)}${chip(t("hide"),"hide",S.hide)}</div>
